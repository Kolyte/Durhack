# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored: never commit real keys.
# Plain KEY=value lines, no quotes.

# Gemini file explanations (create a free key at https://aistudio.google.com -> API keys)
GEMINI_API_KEY=
# Optional: a model listed in AI Studio (Flash/Lite models have the biggest free limits)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: GitHub token for 5,000 GitHub API requests/hour instead of 60
# GITHUB_TOKEN=

# ---------- Accounts: "Sign in with GitHub" (optional) ----------
# Create an OAuth app at https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/login/oauth2/code/github
# Without these two, the app runs with no sign-in button.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------- Payments: Stripe subscription for Sonyx Pro (optional) ----------
# Use TEST keys (sk_test_...) locally. Billing turns on only when all three are set;
# until then every Pro feature stays free for everyone.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=price_...
# From `stripe listen --forward-to localhost:8080/api/stripe/webhook` (whsec_...)
# STRIPE_WEBHOOK_SECRET=
# Text shown on the pricing dialog; keep it in sync with the Stripe price
# STRIPE_PRICE_LABEL=£4.99/month
# Public URL used for Stripe's return links (defaults to the URL of the current request)
# APP_BASE_URL=http://localhost:5173
# Extra origins allowed to open the WebSocket (comma-separated). Same-origin is always allowed.
# ALLOWED_ORIGINS=
# Currency for shop prices (default gbp)
# SHOP_CURRENCY=gbp
